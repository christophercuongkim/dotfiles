# Ghostty Configuration
# Red/Black theme to match desktop

# Font
font-family = JetBrainsMono Nerd Font Mono
font-size = 12

# Colors - Red/Black theme
background = #000000
foreground = #ffffff
cursor-color = #ffffff
selection-background = #ff0000
selection-foreground = #ffffff

# ANSI colors
palette = 0=#000000
palette = 1=#ff0000
palette = 2=#44ff44
palette = 3=#aaaaaa
palette = 4=#4488ff
palette = 5=#ff44ff
palette = 6=#44ffff
palette = 7=#aaaaaa
palette = 8=#666666
palette = 9=#ff4444
palette = 10=#66ff66
palette = 11=#cccccc
palette = 12=#6699ff
palette = 13=#ff66ff
palette = 14=#66ffff
palette = 15=#ffffff

# Shell
shell-integration = zsh

# Keybinds
keybind = ctrl+p=paste_from_clipboard
