/* Red and Black theme for rofi */

* {
    /* Core colors */
    bg:                     #000000;
    bg-alt:                 #111111;
    bg-selected:            #222222;
    fg:                     #ffffff;
    fg-alt:                 #aaaaaa;
    red:                    #ff0000;
    red-dark:               #cc0000;
    urgent:                 #ff4444;

    /* Applied colors */
    background-color:       transparent;
    text-color:             @fg;
    accent:                 @red;
}

configuration {
    modi:                   "drun,run,window";
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    display-drun:           " Apps";
    display-run:            " Run";
    display-window:         " Windows";
    drun-display-format:    "{name}";
    font:                   "JetBrainsMono Nerd Font 11";
}

window {
    width:                  600px;
    padding:                20px;
    border:                 2px solid;
    border-color:           @red;
    border-radius:          10px;
    background-color:       @bg;
    transparency:           "real";
}

mainbox {
    spacing:                15px;
    children:               [ inputbar, message, listview ];
}

inputbar {
    padding:                10px 15px;
    spacing:                10px;
    background-color:       @bg-alt;
    border-radius:          8px;
    children:               [ prompt, entry ];
}

prompt {
    text-color:             @red;
    font:                   "JetBrainsMono Nerd Font Bold 11";
}

entry {
    placeholder:            "Search...";
    placeholder-color:      @fg-alt;
}

message {
    padding:                10px;
    background-color:       @bg-alt;
    border-radius:          8px;
}

textbox {
    text-color:             @fg;
}

listview {
    lines:                  8;
    columns:                1;
    fixed-height:           false;
    spacing:                5px;
    scrollbar:              false;
}

element {
    padding:                10px 15px;
    spacing:                10px;
    border-radius:          6px;
}

element normal.normal,
element alternate.normal {
    background-color:       transparent;
    text-color:             @fg;
}

element selected.normal {
    background-color:       @red;
    text-color:             @fg;
}

element normal.urgent,
element alternate.urgent {
    text-color:             @urgent;
}

element selected.urgent {
    background-color:       @urgent;
    text-color:             @fg;
}

element normal.active,
element alternate.active {
    text-color:             @red;
}

element selected.active {
    background-color:       @red;
    text-color:             @fg;
}

element-icon {
    size:                   24px;
    background-color:       transparent;
}

element-text {
    background-color:       transparent;
    text-color:             inherit;
    vertical-align:         0.5;
}

scrollbar {
    width:                  4px;
    handle-width:           4px;
    handle-color:           @red;
    background-color:       @bg-alt;
    border-radius:          2px;
}

mode-switcher {
    spacing:                10px;
}

button {
    padding:                8px 16px;
    background-color:       @bg-alt;
    text-color:             @fg;
    border-radius:          6px;
}

button selected {
    background-color:       @red;
    text-color:             @fg;
}
